rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Catch-all default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUser(data) {
      return data.userId == request.auth.uid &&
             (!('email' in data) || (data.email is string && data.email.size() <= 200)) &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
             (!('selectedLanguage' in data) || (data.selectedLanguage is string && data.selectedLanguage.size() <= 50)) &&
             (!('streak' in data) || data.streak is number) &&
             (!('lastActiveDate' in data) || (data.lastActiveDate is string && data.lastActiveDate.size() <= 30));
    }

    function isValidNote(data) {
      return data.userId == request.auth.uid &&
             data.title is string && data.title.size() <= 200 &&
             data.content is string && data.content.size() <= 10000 &&
             data.languageId is string && data.languageId.size() <= 50;
    }

    function isValidQuiz(data) {
      return data.userId == request.auth.uid &&
             data.quizId is string && data.quizId.size() <= 100 &&
             data.score is number && data.total is number;
    }

    function isValidFavorite(data) {
      return data.userId == request.auth.uid &&
             data.itemId is string && data.itemId.size() <= 100 &&
             data.languageId is string && data.languageId.size() <= 50;
    }

    // User Profile Document
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming());
      allow delete: if isOwner(userId);

      // User Quizzes Subcollection
      match /quizzes/{quizAttemptId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidQuiz(incoming());
        allow update: if isOwner(userId) && isValidQuiz(incoming());
        allow delete: if isOwner(userId);
      }

      // User Notes Subcollection
      match /notes/{noteId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidNote(incoming());
        allow update: if isOwner(userId) && isValidNote(incoming());
        allow delete: if isOwner(userId);
      }

      // User Favorites Subcollection
      match /favorites/{favId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidFavorite(incoming());
        allow update: if isOwner(userId) && isValidFavorite(incoming());
        allow delete: if isOwner(userId);
      }
    }
  }
}
